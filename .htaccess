Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect the project base URL to Laravel's public document root.
    RewriteRule ^$ %{REQUEST_URI}public/ [R=302,L]

    # Block application internals and sensitive project files.
    RewriteRule ^(?:app|bootstrap|config|database|resources|routes|storage|tests|vendor)(?:/|$) - [F,L]
    RewriteRule ^(?:\.env(?:\..*)?|artisan|composer\.(?:json|lock)|package\.json|phpunit\.xml|vite\.config\.js|README\.md)$ - [F,L]

    # Send requests to Laravel's public directory.
    RewriteCond %{REQUEST_URI} !^/public(?:/|$)
    RewriteRule ^(.*)$ public/$1 [L]

</IfModule>
